# Neon PostgreSQL (development branch)
# Pooled connection (host contains "-pooler") — used by the app at runtime
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection (no "-pooler") — used by Prisma CLI for migrations
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# NextAuth v5 (generate the secret with `npx auth secret`)



# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Connection String
DATABASE_URL=""

# NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend (Email)
RESEND_API_KEY=""

# Email Verification: set to "true" to turn it off (no email sent, unverified users can sign in). Restart the server after changing.
SKIP_EMAIL_VERIFICATION=""

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
# Unused: hosted Checkout and the Customer Portal need no Stripe.js
STRIPE_PUBLISHABLE_KEY=""
# Local: the whsec_… printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Pro gating: leave empty in development (every user gets every feature); set to "true" before launch
# to apply the free-tier limits (50 items, 3 collections, no file/image uploads). Restart the server after changing.
ENFORCE_PRO_LIMITS=""

# Open AI Key
OPENAI_API_KEY=""
