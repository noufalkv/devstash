# Neon PostgreSQL (development branch)
# Pooled connection (host contains "-pooler") — used by the app at runtime
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler") — used by Prisma CLI for migrations
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth v5 (generate the secret with `npx auth secret`)



# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Connection String
DATABASE_URL=""

# NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend (Email)
RESEND_API_KEY=""

# Email Verification: set to "true" to turn it off (no email sent, unverified users can sign in). Restart the server after changing.
SKIP_EMAIL_VERIFICATION=""

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Open AI Key
OPENAI_API_KEY=""
